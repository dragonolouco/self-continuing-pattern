{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dragonolouco/self-continuing-pattern/schemas/method.schema.json",
  "title": "ReusableMethod",
  "type": "object",
  "required": ["id", "version", "preconditions", "steps", "postconditions", "verification"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["experimental", "validated", "deprecated", "quarantined"]}
  },
  "additionalProperties": false
}
