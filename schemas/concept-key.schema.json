{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dragonolouco/self-continuing-pattern/schemas/concept-key.schema.json",
  "title": "ConceptualKey",
  "type": "object",
  "required": ["id", "version", "domain", "goal", "types", "state", "constraints", "verification"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "domain": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "types": {"type": "array", "items": {"type": "string"}},
    "context": {"type": "object", "additionalProperties": true},
    "state": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "method": {"type": "string"},
    "source": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
